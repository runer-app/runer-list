{
  "name": "@runer/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "design": "vite --config preview/vite.config.ts",
    "pretest": "cargo build -p runer-vault-node"
  },
  "dependencies": {
    "@runer/client-core": "*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/svelte": "^5.2.8",
    "jsdom": "^27.0.0",
    "svelte-check": "^4.3.0",
    "vite": "^7.3.7"
  }
}
