{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands, the core event and channel plumbing, and dragging the window by its title-bar area. No plugin commands, no filesystem, no shell.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-vault-accounts",
    "allow-vault-set-inbox",
    "allow-vault-sign-in",
    "allow-vault-start-sign-up",
    "allow-vault-solve-sign-up-pow",
    "allow-vault-confirm-sign-up",
    "allow-vault-sign-out",
    "allow-vault-show-words",
    "allow-vault-seal-account-settings",
    "allow-vault-open-account-settings",
    "allow-vault-sign-server-message",
    "allow-vault-load-identity",
    "allow-vault-change-account-key",
    "allow-vault-commit-account-key",
    "allow-vault-apply-log",
    "allow-vault-list-state",
    "allow-vault-check-head",
    "allow-vault-forget-list",
    "allow-vault-create-list",
    "allow-vault-rotate",
    "allow-vault-seal-content",
    "allow-vault-open-contents",
    "allow-vault-add-member",
    "allow-vault-remove-member",
    "allow-vault-leave",
    "allow-vault-known-contacts",
    "allow-vault-safety-code",
    "allow-vault-create-invite",
    "allow-vault-uninvite",
    "allow-vault-open-invite-link",
    "allow-vault-read-invite-package",
    "allow-vault-join",
    "allow-store-get",
    "allow-store-range",
    "allow-store-write",
    "allow-net-request",
    "allow-net-socket-open",
    "allow-net-socket-send",
    "allow-net-socket-close",
    "allow-notify-replace-all",
    "allow-notify-permission",
    "allow-notify-request-permission",
    "allow-wake-pending",
    "allow-wake-done",
    "allow-debug-log-append",
    "allow-debug-log-read",
    "allow-debug-log-clear",
    "allow-links-initial"
  ]
}
